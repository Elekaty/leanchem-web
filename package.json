{
  "name": "leanchem-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix server run dev",
    "build": "tsc -b && vite build",
    "build:api": "npm --prefix server run build",
    "preview": "vite preview",
    "db:up": "docker compose up -d",
    "db:migrate": "npm --prefix server run db:migrate",
    "setup": "npm install && npm --prefix server install",
    "db:start": "npm --prefix server run db:start",
    "db:create": "npm --prefix server run db:create"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
