# LeanChems — environment template (Phase 1)
# Copy to `.env` / `.env.local` and fill values. Never commit secrets.

# ---------------------------------------------------------------------------
# Public (Vite) — available in the browser as import.meta.env.VITE_*
# NEXT_PUBLIC_* aliases are also accepted for Supabase (Next.js-style naming).
# ---------------------------------------------------------------------------
VITE_SITE_URL=http://localhost:3000
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Floating chat (Phase 4)
VITE_WHATSAPP_URL=https://wa.me/251963730000
VITE_TELEGRAM_URL=https://t.me/leanchem
VITE_CONTACT_EMAIL=sales@leanchems.com

# ---------------------------------------------------------------------------
# Server-only — never prefix with VITE_ (API routes / server functions)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Loop A RFQ notifications
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=LeanChem <onboarding@resend.dev>
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# News curation (server-only — never prefix with VITE_)
CRON_SECRET=replace_with_long_random_secret
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=
GNEWS_API_KEY=
NEWS_API_KEY=
